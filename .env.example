# Copy to .env (gitignored) and fill in. Values already set in the environment win

# GCP project for the x86 VM; a dedicated project keeps billing and cleanup simple
CC_PROJECT=your-gcp-project-id
# CC_ZONE=us-central1-b
# CC_VM=cc-x86
# CC_MACHINE=n2-standard-16
# CC_DISK_GB=500

# Directory holding openai.txt (one bare key). Keep it outside the repo
CC_CREDENTIALS_DIR=~/path/to/credentials
